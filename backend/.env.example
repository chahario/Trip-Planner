# .env — copy to a real .env or set these in your host's dashboard.
# Everything has a working default; nothing here is required.

# Service
ENVIRONMENT=production
LOG_LEVEL=INFO
# Comma-separated allowed origins. "*" is fine for a public demo.
CORS_ORIGINS=*

# OpenStreetMap (no API key needed)
OSM_ENABLED=true
SEARCH_RADIUS_M=100000
HTTP_TIMEOUT_SECONDS=12
# IMPORTANT: Nominatim REJECTS generic / example.com user agents with HTTP 403,
# which silently breaks city lookups. Keep a real, app-identifying value here.
HTTP_USER_AGENT=TripPlanner/1.0 (+https://github.com/your-user/trip-planner)

# LLM — needed for the AI itineraries, AI city selection and "famous for"
# highlights. Without it the app still runs but falls back to curated data.
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Per-user trip rate limit (plan generations per rolling window). 0 disables.
TRIP_RATE_LIMIT=10
TRIP_RATE_WINDOW_HOURS=24

# SQLite file. On ephemeral hosts (Render free) this resets on redeploy; point
# it at a mounted volume (e.g. /data/tripplanner.db) to persist history.
DB_PATH=tripplanner.db

# --- Optional data integrations (each activates only when its key is set) ---

# Hotels near the plan — Geoapify (FREE, 3,000/day, no credit card). Recommended.
# GEOAPIFY_API_KEY=...

# Travel time between stops — OpenRouteService (free tier).
# ORS_API_KEY=...

# Places + food — Foursquare. NOTE: the 2025 Places API now requires paid
# credits; without credits it returns 429 and the app falls back to OSM/curated.
# FOURSQUARE_API_KEY=...

# Hotels (alternative) — Amadeus Self-Service (free TEST env).
# AMADEUS_CLIENT_ID=...
# AMADEUS_CLIENT_SECRET=...
